library(tidyverse)
library(tidyverse)
set.seed(42)
younguns <- tibble(
age = sample(12:30, 100, replace = TRUE)
)
head(younguns)
set.seed(42)
younguns <- tibble(
age = sample(18:80, 1000, replace = TRUE)
)
head(younguns)
View(younguns)
sample_50 <-younguns |>
sample_n(50)
sample_10 <-younguns |>
sample_n(10)
sample_100 <-younguns |>
sample_n(100)
sample_100 |> summarize(mean = mean(age), median = median(age), sd = sd(age))
younguns |> summarize(mean = mean(age), median = median(age), sd = sd(age))
sample_20 <-younguns |>
sample_n(20)
sample_20 |> summarize(mean = mean(age), median = median(age), sd = sd(age))
sample_100 |> summarize(mean = mean(age), median = median(age), sd = sd(age))
sample_100 <-younguns |>
sample_n(100)
