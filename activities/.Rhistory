homtemp <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/pg_murder_temps.csv")
homtemp |> summarize(correlation = cor(aptitude, performance, method="pearson"))
View(homtemp)
homtemp |> summarize(correlation = cor(murders, temperature, method="pearson"))
