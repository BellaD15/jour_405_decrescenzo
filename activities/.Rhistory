library(tidyverse)
inspections <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/montco_inspections.csv")
View(inspections)
compliance_stats |>
summarize(mean_stats = mean(compliance_score),
median_salary = median(compliance_score),
max_salary = max (compliance_score),
min_salary = min (compliance_score)
compliance_stats |>
summarize(mean_stats = mean(compliance_score),
median_salary = median(compliance_score),
max_salary = max (compliance_score),
min_salary = min (compliance_score))
compliance_stats <- inspections|>
summarize(mean_stats = mean(compliance_score),
median_salary = median(compliance_score),
max_salary = max (compliance_score),
min_salary = min (compliance_score))
View(compliance_stats)
compliance_stats <- inspections|>
summarize(mean_score = mean(compliance_score),
median_score = median(compliance_score),
max_score = max (compliance_score),
min_score = min (compliance_score))
View(compliance_stats)
inspections |>
ggplot() +
geom_histogram(aes(x = compliance_score), binwidth = 1) +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed", size = 1) +
labs(title = "Distribution of Restaurants' Compliance Scores in Montgomery County", x = "Compliance Score", y = "Number of restaurants")
compliance_stats <- inspections|>
summarize(mean_score = mean(compliance_score),
median_score = median(compliance_score),
max_score = max (compliance_score),
min_score = min (compliance_score),
sd_score = sd(compliance_score))
participation <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_hs_participation.csv")
View(participation)
participation |>
mutate(total = boys + girls),
participation |>
mutate(total = boys + girls)
mutate(girls_pct = (boys + girls)/girls)
participation |>
mutate(total = `boys` + `girls`)
mutate(girls_pct = (`boys` + `girls`)/`girls`)
participation |>
mutate(total = boys+girls)
mutate(girls_pct = (boys + girls)/girls)
participation |>
mutate(total = boys + girls) |>
mutate(girls_pct = (boys + girls)/girls)
participation |>
mutate(total = boys + girls) |>
mutate(girls_pct = (boys + girls)/girls)
participation |>
mutate(total = boys + girls) |>
mutate(girls_pct = (total/girls) * 100)
participation |>
mutate(total = boys + girls) |>
mutate(girls_pct = (girls/total) * 100)
participation |> summarize(correlation = cor(boys, girls, method="pearson"))
participation |>
ggplot() +
geom_point(aes(x=girls, y=boys)) +
geom_smooth(aes(x=girls, y=boys), method="lm")+
labs(title = "Relationship between sports participation of highschool boys and girls in 2024 Maryland counties", x = "Girls' participation in sports", y = "Boys' Participation in sports")
participation |>
ggplot() +
geom_point(aes(x=girls, y=boys)) +
geom_smooth(aes(x=girls, y=boys), method="lm")+
labs(title = "Relationship between gender and MD highschool sports participation", x = "Girls' participation in sports", y = "Boys' Participation in sports")
